{
  "token-optimizer": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 hooks/pre_invocation.py",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "read_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/pre_tool_use.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/post_tool_use.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
