  "injected_failure": {
    "note": "CI-failure triage scenario: a deterministic failing test file is written into the temp clone (never committed upstream) to produce a REAL pytest failure output on real code — standard SWE-bench-style regression injection, pre-registered here.",
    "test_source": "def test_bench_injected_regression():\n    assert False, \"bench: pre-registered injected regression\"\n",
    "file": "tests/test_bench_injected.py"
  },
  "secret_guard": {
    "note": "Security scenario: a pre-registered FAKE .env fixture is written into the temp clone (values are synthetic, never real secrets); the guard must deny reading it and leak zero secret values into the model context.",
    "env_content": "# Database credentials (bench fixture — synthetic values)\nDATABASE_URL=postgres://admin:SuperSecret9f3b@db.internal:5432/prod\nAPI_KEY=sk-live-4c9a1f77e2b34d08a91c6d5e7f0b2a3d\nJWT_SECRET=9f3b1c77e2b34d08a91c6d5e7f0b2a3d9f3b\nSTRIPE_WEBHOOK_SECRET=whsec_5f4eecb9821a4c1d9e7f0b2a3d4c5e6f\nSMTP_PASS=P@ssw0rd-bench-7712\n"
  },
  "prompt_compaction": {
    "template": "Please look at {file} and refactor the {symbol} function to handle the following edge cases properly: handle empty and None inputs with clear error messages, validate all incoming parameters before mutating state, add proper error messages, update the docstring, make the logging consistent with the rest of the codebase, keep the public signature backward compatible, avoid breaking existing callers, extract repeated logic into small private helpers, cover every new branch with tests, and make sure the feature flags still work as documented for both the community and the paid tiers of the product."
  },
  "zero_loss_gates": {
    "symbol_read": [
      "symbol_present",
      "valid_python",
      "all_top_level_defs_present",
      "signature_line_match"
    ],
    "test_output": [
      "failing_test_name_present",
      "error_type_present",
      "first_traceback_frame_present"
    ],
    "multiturn": [
      "all_reads_lossless"
    ],
    "architecture": [
      "hub_files_listed",
      "compact_bound"
    ],
    "raw_search": [
      "matches_exist",
      "paths_preserved"
    ],
    "git_diff": [
      "changed_files_preserved"
    ],
    "write_egress": [
      "inserted_line_present",
      "original_signature_in_target"
    ],
    "api_surface": [
      "hub_files_listed",
      "smaller_than_crawl"
    ],
    "kv_cache": [
      "prefix_hit_rate_ge_80",
      "input_reduction_positive"
    ],
    "secret_guard": [
      "deny_decision",
      "no_secret_leak"
    ],
    "junk_read": [
      "capped_output",
      "junk_file_named"
    ],
    "prompt_compaction": [
      "action_extracted",
      "target_file_preserved",
      "savings_positive"
    ]
  }
}