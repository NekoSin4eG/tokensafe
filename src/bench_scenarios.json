{
  "version": 3,
  "created": "2026-11-14",
  "methodology": "Pre-registered real-repo benchmark. Scenarios are committed BEFORE any measurement (anti cherry-picking; v1/v2 rows stay frozen). All token counts are measured with the calibrated BPE tokenizer on real repository bytes. Every scenario carries deterministic zero-loss gates; a gate failure disqualifies the scenario from the savings table. v3 adds: API surface map, KV-cache prefix locking replay, secret-guard interception, junk-read guard, prompt compaction (TOCP).",
  "metrics": [
    "token_reduction_pct",
    "usd_saved_sonnet_input",
    "usd_saved_sonnet_output",
    "kv_cache_hit_rate_pct",
    "zero_loss_gates"
  ],
  "pricing": {
    "sonnet_input_usd_per_mtok": 3.0,
    "sonnet_cached_usd_per_mtok": 0.3,
    "sonnet_output_usd_per_mtok": 15.0
  },
  "repos": [
    {
      "key": "flask",
      "url": "https://github.com/pallets/flask",
      "clone_depth": 50,
      "raw_search": {
        "pattern": "def test_",
        "dir": "tests"
      },
      "symbol_read": {
        "file": "src/flask/app.py",
        "symbol": "Flask.full_dispatch_request"
      },
      "pytest": {
        "subset_glob": "tests/",
        "deps": [
          "werkzeug",
          "jinja2",
          "itsdangerous",
          "click",
          "blinker"
        ]
      },
      "multiturn_reads": [
        {
          "file": "src/flask/app.py",
          "symbol": "Flask.full_dispatch_request"
        },
        {
          "file": "src/flask/wrappers.py",
          "symbol": "Request.full_path"
        },
        {
          "file": "src/flask/config.py",
          "symbol": "Config.from_pyfile"
        }
      ]
    },
